k<?xml version="1.0"?>

<launch>

  <!-- Hector SLAM -->
  <node pkg="hector_mapping"
        type="hector_mapping"
        name="hector_mapping"
        output="screen">

    <param name="map_frame" value="map"/>
    <param name="base_frame" value="base_link"/>
    <param name="odom_frame" value="base_link"/>

  </node>

</launch>
